{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "description": "Base Clang toolchain preset",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "COMPILER_FLAVOR": "Clang"
      }
    },
    { "name": "clang-debug", "displayName": "Clang Debug", "inherits": ["clang", "debug"] },
    { "name": "clang-release", "displayName": "Clang Release", "inherits": ["clang", "release"] },
    { "name": "clang-minsizerel", "displayName": "Clang MinSizeRel", "inherits": ["clang", "minsizerel"] },
    { "name": "clang-profile", "displayName": "Clang Profile", "inherits": ["clang", "profile"] }
  ],
  "buildPresets": [
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-minsizerel", "configurePreset": "clang-minsizerel" },
    { "name": "clang-profile", "configurePreset": "clang-profile" }
  ],
  "testPresets": [
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "clang-minsizerel", "configurePreset": "clang-minsizerel", "output": { "outputOnFailure": true } },
    { "name": "clang-profile", "configurePreset": "clang-profile", "output": { "outputOnFailure": true } }
  ]
}
