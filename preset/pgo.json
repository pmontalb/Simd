    { "name": "aocc-lto-pgo-opti", "configurePreset": "aocc-lto-pgo-opti", "output": { "outputOnFailure": true } },

    { "name": "gcc-lto-pgo-fast-math-train", "configurePreset": "gcc-lto-pgo-fast-math-train", "output": { "outputOnFailure": true } },
    { "name": "gcc-lto-pgo-fast-math-opti", "configurePreset": "gcc-lto-pgo-fast-math-opti", "output": { "outputOnFailure": true } },
    { "name": "clang-lto-pgo-fast-math-train", "configurePreset": "clang-lto-pgo-fast-math-train", "output": { "outputOnFailure": true } },
