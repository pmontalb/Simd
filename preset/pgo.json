    { "name": "gcc-lto-pgo-fast-math-train", "configurePreset": "gcc-lto-pgo-fast-math-train" },
    { "name": "gcc-lto-pgo-fast-math-opti", "configurePreset": "gcc-lto-pgo-fast-math-opti" },
    { "name": "clang-lto-pgo-fast-math-train", "configurePreset": "clang-lto-pgo-fast-math-train" },
    { "name": "clang-lto-pgo-fast-math-opti", "configurePreset": "clang-lto-pgo-fast-math-opti" },
    { "name": "icpx-lto-pgo-fast-math-train", "configurePreset": "icpx-lto-pgo-fast-math-train" },
    { "name": "icpx-lto-pgo-fast-math-opti", "configurePreset": "icpx-lto-pgo-fast-math-opti" },
    { "name": "aocc-lto-pgo-fast-math-train", "configurePreset": "aocc-lto-pgo-fast-math-train" },
    { "name": "aocc-lto-pgo-fast-math-opti", "configurePreset": "aocc-lto-pgo-fast-math-opti" }
  ],
  "testPresets": [
    { "name": "gcc-pgo-train", "configurePreset": "gcc-pgo-train", "output": { "outputOnFailure": true } },
    { "name": "gcc-pgo-opti", "configurePreset": "gcc-pgo-opti", "output": { "outputOnFailure": true } },
    { "name": "clang-pgo-train", "configurePreset": "clang-pgo-train", "output": { "outputOnFailure": true } },
    { "name": "clang-pgo-opti", "configurePreset": "clang-pgo-opti", "output": { "outputOnFailure": true } },
    { "name": "icpx-pgo-train", "configurePreset": "icpx-pgo-train", "output": { "outputOnFailure": true } },
    { "name": "icpx-pgo-opti", "configurePreset": "icpx-pgo-opti", "output": { "outputOnFailure": true } },
