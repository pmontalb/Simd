    { "name": "aocc-lto-pgo-fast-math-train", "configurePreset": "aocc-lto-pgo-fast-math-train", "output": { "outputOnFailure": true } },
    { "name": "aocc-lto-pgo-fast-math-opti", "configurePreset": "aocc-lto-pgo-fast-math-opti", "output": { "outputOnFailure": true } }
